# Server-only API origin. Do not replace this with a NEXT_PUBLIC variable.
DWELVE_API_BASE_URL="http://localhost:5001/api/v1"

# Encrypts the application session cookie. Use a long random value outside local development.
SESSION_SECRET="replace-with-a-long-random-development-secret"

# Browser-visible Google Web OAuth client identifier. Required for production sign-in.
# Left empty here on purpose: it is deployment configuration, not a repository value.
# An empty value is not an error — the Google button silently renders its
# "unavailable" state and no request ever reaches the backend. Fill it in for any
# local session that needs Google sign-in, using the same Web OAuth client as the
# backend's GOOGLE_CLIENT_ID, and make sure that client authorizes this app's exact
# origin (http://localhost:3000). See docs/operations/DEVELOPMENT_AND_DEPLOYMENT.md
# and .agent-memory/gotchas/google-oauth-configuration-parity.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Optional support links shown by the application.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_TELEGRAM=""
