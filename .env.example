# Server-only API origin. Do not replace this with a NEXT_PUBLIC variable.
DWELVE_API_BASE_URL="http://localhost:5001/api/v1"

# Encrypts the application session cookie. Use a long random value outside local development.
SESSION_SECRET="replace-with-a-long-random-development-secret"

# Browser-visible Google Web OAuth client identifier. Required for production sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Optional support links shown by the application.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_TELEGRAM=""
